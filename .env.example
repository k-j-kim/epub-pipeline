# --- Synology / paths ---
# Absolute path on the NAS where all data lives. Create this volume first.
DATA_DIR=/volume1/docker/kbfm

# Synology default user is uid 1026 / gid 100 (users). Adjust if different.
PUID=1026
PGID=100
TZ=Asia/Seoul

# --- Ports on the NAS (change if collisions) ---
QB_PORT=8181
CW_PORT=8283
MGMT_PORT=8484

# --- qBittorrent WebUI creds (set after first login; worker uses these) ---
QB_USER=admin
QB_PASS=adminadmin

# --- Send-to-Kindle ---
# Approved sender must be added at Amazon > Manage Your Content and Devices > Preferences
KINDLE_EMAIL=your-mom@kindle.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=app-password-not-your-real-password
SMTP_FROM=you@gmail.com

# --- Curation knobs ---
BOOKS_PER_WEEK=5
MIN_EPUB_KB=200
MAX_EPUB_MB=50

# --- Sources ---
# Which fetchers to run on each refresh, space-separated. Order matters.
# AA is off by default — all three canonical hosts (per Wikipedia) sit
# behind DDoS-Guard's JS challenge, which cookies alone can't survive.
# Add `aa` back if you're willing to periodically paste fresh headers
# via the mgmt UI's bypass panel.
SOURCES=ia libgen

# Per-run download budgets. Weekly volume ≈ these × refresh frequency.
IA_MAX_PER_RUN=40
LIBGEN_MAX_PER_RUN=20
AA_MAX_PER_RUN=5

# libgen fiction search host (li is fiction-friendly).
LIBGEN_HOST=libgen.li

# Anna's Archive mirrors, first-reachable wins.
# Update when mirrors rotate — check the AA Wikipedia article.
AA_HOSTS=annas-archive.pk annas-archive.gd annas-archive.gl
# If AA serves a JS interstitial, the mgmt UI at :8484 shows a "bot-gate"
# banner. Paste browser headers (Copy as cURL) — they persist in
# /state/aa_headers.txt and future fetches reuse them.
