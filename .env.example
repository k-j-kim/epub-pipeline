# --- Synology / paths ---
# Absolute path on the NAS where all data lives. Create this volume first.
DATA_DIR=/volume1/docker/kbfm

# Synology default user is uid 1026 / gid 100 (users). Adjust if different.
PUID=1026
PGID=100
TZ=Asia/Seoul

# --- Ports on the NAS (change if collisions) ---
QB_PORT=8181
CW_PORT=8283
MGMT_PORT=8484

# --- qBittorrent WebUI creds (set after first login; worker uses these) ---
QB_USER=admin
QB_PASS=adminadmin

# --- Send-to-Kindle ---
# Approved sender must be added at Amazon > Manage Your Content and Devices > Preferences
KINDLE_EMAIL=your-mom@kindle.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=app-password-not-your-real-password
SMTP_FROM=you@gmail.com

# --- Curation knobs ---
BOOKS_PER_WEEK=5
MIN_EPUB_KB=200
MAX_EPUB_MB=50

# Anna's Archive mirrors to try (space separated, in order).
# Update this list when mirrors rotate — check the AA subreddit or their onion.
AA_HOSTS=annas-archive.pk annas-archive.li annas-archive.gs
AA_INDEX_PATH=/dyn/torrents.json
# Mirrors rotate; check the AA Wikipedia article for the current list.
# If a host serves a JS interstitial instead of JSON, the mgmt UI at :8484
# shows a "bot-gate hit" banner. Paste request headers from your browser
# (DevTools → Copy as cURL) and the pipeline retries automatically.
